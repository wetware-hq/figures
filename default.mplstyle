# figures default_style: Lancet/NEJM submission rules, minimum set
figure.figsize: 4.21, 2.8      # 107 mm wide (Lancet minimum)
savefig.dpi: 300
savefig.bbox: tight
svg.fonttype: none             # text stays text
pdf.fonttype: 42
font.family: sans-serif
font.size: 8
axes.titlesize: 9
axes.titleweight: bold
axes.titlelocation: left
axes.spines.top: False
axes.spines.right: False
axes.grid: False
axes.prop_cycle: cycler('color', ['0072B2','D55E00','009E73','CC79A7'])  # colour-blind safe, solid
lines.linewidth: 1.5
lines.linestyle: -
lines.markersize: 4
legend.frameon: False
